# Radii and ceil(75% radius) deadzones are the only generation policy.
$function chunky_offline:$(operation) {key:"overworld",world:"minecraft:overworld",radius:10000,threshold:7500}
$function chunky_offline:$(operation) {key:"nether",world:"minecraft:the_nether",radius:1250,threshold:938}
$function chunky_offline:$(operation) {key:"end",world:"minecraft:the_end",radius:5000,threshold:3750}
