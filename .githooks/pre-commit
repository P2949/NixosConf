#!/bin/sh
# Cheap commit gate: hosted-CI policy and Nix formatting. Heavy validation stays in receipts.
set -eu
cd "$(git rev-parse --show-toplevel)"
nix shell --no-write-lock-file --inputs-from . nixpkgs#python3 --command \
    python3 scripts/local-ci.py policy
nix fmt --no-write-lock-file -- --ci
