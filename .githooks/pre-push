#!/bin/sh
set -eu
while read -r _local_ref local_sha remote_ref _remote_sha; do
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    case "$remote_ref" in
        refs/heads/main) mode=full ;;
        refs/heads/*) mode=affected ;;
        *) continue ;;
    esac
    ./scripts/validate require-receipt "$mode" "$local_sha"
done
